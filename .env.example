# Enables the LLM router, planner, and forge. Without it forgent still works,
# using deterministic heuristics (PlanCards are marked "heuristic").
ANTHROPIC_API_KEY=sk-ant-...

# Model per role. Defaults shown; any current Claude model ID works.
FORGENT_ROUTER_MODEL=claude-sonnet-5
FORGENT_PLANNER_MODEL=claude-opus-5-5
FORGENT_FORGE_MODEL=claude-opus-5-5
# Retried once when a request is declined by a safety classifier.
FORGENT_FALLBACK_MODEL=claude-opus-5

# Effort per role: low | medium | high | xhigh | max
# (ignored for Haiku 4.5, which does not accept effort)
FORGENT_ROUTER_EFFORT=low
FORGENT_PLANNER_EFFORT=medium
FORGENT_FORGE_EFFORT=high

# Path to the SQLite state DB (created on first run)
FORGENT_DB=./forgent.db
